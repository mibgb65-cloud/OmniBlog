{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omni-blog",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/studio", "/studio/*"],
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": false,
  "vars": {
    "GITHUB_REPOSITORY": "mibgb65-cloud/OmniBlog",
    "GITHUB_BRANCH": "main"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "omniblog-subscribers" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "omniblog-media" }
  ],
  "ratelimits": [
    {
      "name": "STUDIO_LOGIN_RATE_LIMITER",
      "namespace_id": "8432101",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "NEWSLETTER_RATE_LIMITER",
      "namespace_id": "8432102",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "MEDIA_RATE_LIMITER",
      "namespace_id": "8432103",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "STUDIO_MUTATION_RATE_LIMITER",
      "namespace_id": "8432104",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
