{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omni-blog",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
